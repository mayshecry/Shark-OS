+}
+
+void net_drivers_init(void) {
+    net_dev_install(rtl8139_driver_get());
+    net_dev_install(pcnet_driver_get());
+    net_dev_install(e1000_driver_get());
+    net_dev_install(r8169_driver_get());
+    net_dev_install(ne2000_driver_get());
+    net_dev_install(virtio_net_driver_get());
+}
+
+const net_dev_t* net_dev_probe(uint8_t bus, uint8_t slot, uint8_t func,
+                               uint16_t vendor, uint16_t device) {
+    for (uint32_t i = 0; i < net_dev_num; i++) {
+        const net_dev_t* drv = net_devs[i];
+        if (drv->probe && drv->probe(bus, slot, func, vendor, device)) return drv;
+    }
+    return NULL;
+}
+
+const net_dev_t* net_dev_active(void) { return net_dev_current; }
+void net_dev_set_active(const net_dev_t* drv) { net_dev_current = drv; }
+uint32_t net_dev_count(void) { return net_dev_num; }
+const net_dev_t* net_dev_get(uint32_t index) {
+    return index < net_dev_num ? net_devs[index] : NULL;
+}
diff --git a/src/net/drivers/e1000.c b/src/net/drivers/e1000.c
new file mode 100644
index 0000000..28cffcb
--- /dev/null
+++ b/src/net/drivers/e1000.c
@@ -0,0 +1,391 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/e1000.h"
+
+#define E1000_CTRL     0x0000
+#define E1000_STATUS   0x0008
+#define E1000_EERD     0x0014
+#define E1000_ICR      0x00C0
+#define E1000_IMS      0x00D0
+#define E1000_IMC      0x00D8
+#define E1000_RCTL     0x0100
+#define E1000_TCTL     0x0400
+#define E1000_TIPG     0x0410
+#define E1000_RDBAL    0x2800
+#define E1000_RDBAH    0x2804
+#define E1000_RDLEN    0x2808
+#define E1000_RDH      0x2810
+#define E1000_RDT      0x2818
+#define E1000_TDBAL    0x3800
+#define E1000_TDBAH    0x3804
+#define E1000_TDLEN    0x3808
+#define E1000_TDH      0x3810
+#define E1000_TDT      0x3818
+#define E1000_MTA      0x5200
+#define E1000_RAL0     0x5400
+#define E1000_RAH0     0x5404
+
+#define E1000_CTRL_ASDE   (1u << 5)
+#define E1000_CTRL_SLU    (1u << 6)
+#define E1000_CTRL_ILOS   (1u << 7)
+#define E1000_CTRL_RST    (1u << 26)
+#define E1000_CTRL_PHYRST (1u << 31)
+#define E1000_CTRL_LRST   (1u << 3)
+
+#define E1000_RCTL_EN     (1u << 1)
+#define E1000_RCTL_UPE    (1u << 3)
+#define E1000_RCTL_BAM    (1u << 15)
+#define E1000_RCTL_SECRC  (1u << 26)
+#define E1000_TCTL_EN     (1u << 1)
+#define E1000_TCTL_PSP    (1u << 3)
+
+#define E1000_MDIC        0x0020
+#define E1000_FWSM        0x5B54
+#define E1000_FEXTNVM3    0x003C
+#define E1000_EXTCNF_CTRL 0x0F00
+
+#define E1000_CTRL_LANPHYPC_OVERRIDE (1u << 16)
+#define E1000_CTRL_LANPHYPC_VALUE    (1u << 17)
+#define E1000_EXTCNF_GATE_PHY_CFG    (1u << 7)
+#define E1000_FWSM_PHY_RESET_EN      (1u << 6)
+
+#define E1000_MDIC_PHY_ADDR   1u
+#define E1000_MDIC_ADDR_SHIFT 16
+#define E1000_MDIC_READY      (1u << 28)
+#define E1000_MDIC_ERROR      (1u << 30)
+
+#define E1000_MII_BMCR       0
+#define E1000_MII_PHYSID1    2
+#define E1000_MII_PHYSID2    3
+#define E1000_MII_ADVERTISE  4
+#define E1000_BMCR_RESET      0x8000
+#define E1000_BMCR_POWERDOWN  0x0800
+#define E1000_BMCR_ANE        0x1000
+#define E1000_BMCR_RESTART_AN 0x0200
+#define E1000_BMCR_SPEED_MASK 0x2040
+#define E1000_ADV_10_100      0x01E1
+#define E1000_ADV_PAUSE       0x0C00
+
+#define E1000_NRX 32
+#define E1000_NTX 32
+#define E1000_BUF 2048
+
+#define E1000_RXD_STAT_DD  0x01
+#define E1000_RXD_STAT_EOP 0x02
+#define E1000_TXD_STAT_DD  0x01
+#define E1000_TXD_CMD_EOP  0x01
+#define E1000_TXD_CMD_IFCS 0x02
+#define E1000_TXD_CMD_RS   0x08
+#define E1000_RAH_AV       0x80000000u
+#define E1000_STATUS_LU    0x0002
+#define E1000_EERD_START   0x01
+#define E1000_EERD_DONE    0x10
+#define E1000_EERD_DONE_SOFT 0x02
+
+struct e1000_rxd {
+    uint32_t addr_lo, addr_hi;
+    uint16_t length;
+    uint16_t csum;
+    uint8_t  status;
+    uint8_t  errors;
+    uint16_t special;
+} __attribute__((packed));
+
+struct e1000_txd {
+    uint32_t addr_lo, addr_hi;
+    uint16_t length;
+    uint8_t  cso;
+    uint8_t  cmd;
+    uint8_t  status;
+    uint8_t  css;
+    uint16_t special;
+} __attribute__((packed));
+
+typedef struct {
+    uintptr_t mmio;
+    struct e1000_rxd* rx;
+    struct e1000_txd* tx;
+    uint8_t* rxb[E1000_NRX];
+    uint8_t* txb[E1000_NTX];
+    int rx_head;
+    int tx_tail;
+    int pch2;
+    uint32_t last_link_tick;
+} e1000_dev_t;
+
+static e1000_dev_t e1000_dev;
+
+static inline void e1000_w(uint32_t reg, uint32_t v) {
+    *(volatile uint32_t*)(e1000_dev.mmio + reg) = v;
+}
+
+static inline uint32_t e1000_r(uint32_t reg) {
+    return *(volatile uint32_t*)(e1000_dev.mmio + reg);
+}
+
+static void* e1000_alloc16(uint32_t size) {
+    uint8_t* m = (uint8_t*)kmalloc(size + 16);
+    if (!m) return NULL;
+    uintptr_t a = ((uintptr_t)m + 15) & ~(uintptr_t)15;
+    memset((void*)a, 0, size);
+    return (void*)a;
+}
+
+static int e1000_eeprom_read(uint8_t addr, uint16_t* out) {
+    e1000_w(E1000_EERD, ((uint32_t)addr << 8) | E1000_EERD_START);
+    for (int i = 0; i < 100000; i++) {
+        uint32_t v = e1000_r(E1000_EERD);
+        if (v & E1000_EERD_DONE) { *out = (uint16_t)(v >> 16); return 1; }
+    }
+    e1000_w(E1000_EERD, ((uint32_t)addr << 2) | E1000_EERD_START);
+    for (int i = 0; i < 100000; i++) {
+        uint32_t v = e1000_r(E1000_EERD);
+        if (v & E1000_EERD_DONE_SOFT) { *out = (uint16_t)(v >> 16); return 1; }
+    }
+    return 0;
+}
+
+static void e1000_read_link(void) {
+    netdev_report_link((e1000_r(E1000_STATUS) & E1000_STATUS_LU) ? 1 : 0);
+}
+
+static int e1000_mdic_read(uint8_t reg, uint16_t* out) {
+    e1000_w(E1000_MDIC, (uint32_t)reg |
+            ((uint32_t)E1000_MDIC_PHY_ADDR << E1000_MDIC_ADDR_SHIFT) | (2u << 26));
+    for (int i = 0; i < 5000; i++) {
+        uint32_t v = e1000_r(E1000_MDIC);
+        if (v & E1000_MDIC_ERROR) return 0;
+        if (v & E1000_MDIC_READY) { *out = (uint16_t)(v & 0xFFFFu); return 1; }
+    }
+    return 0;
+}
+
+static int e1000_mdic_write(uint8_t reg, uint16_t val) {
+    e1000_w(E1000_MDIC, (uint32_t)val | (uint32_t)reg |
+            ((uint32_t)E1000_MDIC_PHY_ADDR << E1000_MDIC_ADDR_SHIFT) | (1u << 26));
+    for (int i = 0; i < 5000; i++) {
+        uint32_t v = e1000_r(E1000_MDIC);
+        if (v & E1000_MDIC_ERROR) return 0;
+        if (v & E1000_MDIC_READY) return 1;
+    }
+    return 0;
+}
+
+static int e1000_phy_is_accessible(void) {
+    uint16_t id = 0;
+    for (int retry = 0; retry < 2; retry++) {
+        if (!e1000_mdic_read(E1000_MII_PHYSID1, &id) || id == 0xFFFF) continue;
+        if (!e1000_mdic_read(E1000_MII_PHYSID2, &id) || id == 0xFFFF) continue;
+        return 1;
+    }
+    return 0;
+}
+
+static void e1000_toggle_lanphypc(void) {
+    uint32_t v = e1000_r(E1000_FEXTNVM3);
+    v = (v & ~0x0C000000u) | 0x08000000u;
+    e1000_w(E1000_FEXTNVM3, v);
+
+    v = e1000_r(E1000_CTRL);
+    v |=  E1000_CTRL_LANPHYPC_OVERRIDE;
+    v &= ~E1000_CTRL_LANPHYPC_VALUE;
+    e1000_w(E1000_CTRL, v);
+    (void)e1000_r(E1000_CTRL);
+    for (volatile int i = 0; i < 2000; i++) { }
+    v &= ~E1000_CTRL_LANPHYPC_OVERRIDE;
+    e1000_w(E1000_CTRL, v);
+    (void)e1000_r(E1000_CTRL);
+    delay_ms(50);
+}
+
+static void e1000_pch2_phy_wake(void) {
+    e1000_w(E1000_EXTCNF_CTRL,
+            e1000_r(E1000_EXTCNF_CTRL) | E1000_EXTCNF_GATE_PHY_CFG);
+
+    for (int i = 0; i < 30; i++) {
+        if (e1000_r(E1000_FWSM) & E1000_FWSM_PHY_RESET_EN) break;
+        delay_ms(10);
+    }
+
+    if (!e1000_phy_is_accessible()) e1000_toggle_lanphypc();
+
+    uint16_t bmcr = 0;
+    if (e1000_mdic_read(E1000_MII_BMCR, &bmcr)) {
+        bmcr &= (uint16_t)~(E1000_BMCR_POWERDOWN | E1000_BMCR_SPEED_MASK);
+        e1000_mdic_write(E1000_MII_BMCR, (uint16_t)(bmcr | E1000_BMCR_RESET));
+        delay_ms(1);
+        for (int i = 0; i < 100; i++) {
+            uint16_t r = 0;
+            if (!e1000_mdic_read(E1000_MII_BMCR, &r)) break;
+            if (!(r & E1000_BMCR_RESET)) break;
+            delay_ms(1);
+        }
+    }
+
+    e1000_mdic_write(E1000_MII_ADVERTISE,
+                     (uint16_t)(E1000_ADV_10_100 | E1000_ADV_PAUSE));
+    if (e1000_mdic_read(E1000_MII_BMCR, &bmcr)) {
+        bmcr &= (uint16_t)~(E1000_BMCR_POWERDOWN | E1000_BMCR_RESET);
+        e1000_mdic_write(E1000_MII_BMCR,
+                         (uint16_t)(bmcr | E1000_BMCR_ANE | E1000_BMCR_RESTART_AN));
+    }
+
+    delay_ms(10);
+    e1000_w(E1000_EXTCNF_CTRL,
+            e1000_r(E1000_EXTCNF_CTRL) & ~E1000_EXTCNF_GATE_PHY_CFG);
+}
+
+static int e1000_init_chip(void) {
+    e1000_dev_t* dev = &e1000_dev;
+
+    e1000_w(E1000_IMC, 0xFFFFFFFFu);
+    e1000_w(E1000_CTRL, e1000_r(E1000_CTRL) | E1000_CTRL_RST);
+    delay_ms(10);
+    int rst_wait = dev->pch2 ? 100 : 1000;
+    for (int i = 0; i < rst_wait && (e1000_r(E1000_CTRL) & E1000_CTRL_RST); i++) delay_ms(1);
+    e1000_w(E1000_IMC, 0xFFFFFFFFu);
+    (void)e1000_r(E1000_ICR);
+
+    if (dev->pch2) e1000_pch2_phy_wake();
+
+    uint32_t ctrl = e1000_r(E1000_CTRL);
+    ctrl |= E1000_CTRL_SLU | E1000_CTRL_ASDE;
+    ctrl &= ~(E1000_CTRL_LRST | E1000_CTRL_ILOS | E1000_CTRL_PHYRST);
+    e1000_w(E1000_CTRL, ctrl);
+
+    uint32_t ral = e1000_r(E1000_RAL0), rah = e1000_r(E1000_RAH0);
+    if (ral == 0 && (rah & 0xFFFF) == 0) {
+        uint16_t w0, w1, w2;
+        if (e1000_eeprom_read(0, &w0) && e1000_eeprom_read(1, &w1) &&
+            e1000_eeprom_read(2, &w2)) {
+            ral = (uint32_t)w0 | ((uint32_t)w1 << 16);
+            rah = w2;
+        }
+    }
+    uint8_t mac[6];
+    mac[0] = ral & 0xFF;         mac[1] = (ral >> 8) & 0xFF;
+    mac[2] = (ral >> 16) & 0xFF; mac[3] = (ral >> 24) & 0xFF;
+    mac[4] = rah & 0xFF;         mac[5] = (rah >> 8) & 0xFF;
+    netdev_set_mac(mac);
+    e1000_w(E1000_RAL0, ral);
+    e1000_w(E1000_RAH0, (rah & 0xFFFF) | E1000_RAH_AV);
+    for (int i = 0; i < 128; i++) e1000_w(E1000_MTA + i * 4, 0);
+
+    dev->rx = (struct e1000_rxd*)e1000_alloc16(sizeof(struct e1000_rxd) * E1000_NRX);
+    dev->tx = (struct e1000_txd*)e1000_alloc16(sizeof(struct e1000_txd) * E1000_NTX);
+    if (!dev->rx || !dev->tx) return 0;
+
+    for (int i = 0; i < E1000_NRX; i++) {
+        dev->rxb[i] = (uint8_t*)e1000_alloc16(E1000_BUF);
+        if (!dev->rxb[i]) return 0;
+        dev->rx[i].addr_lo = (uint32_t)virt_to_phys(dev->rxb[i]);
+        dev->rx[i].addr_hi = 0;
+        dev->rx[i].status = 0;
+    }
+    e1000_w(E1000_RDBAL, (uint32_t)virt_to_phys(dev->rx));
+    e1000_w(E1000_RDBAH, 0);
+    e1000_w(E1000_RDLEN, sizeof(struct e1000_rxd) * E1000_NRX);
+    e1000_w(E1000_RDH, 0);
+    e1000_w(E1000_RDT, E1000_NRX - 1);
+    dev->rx_head = 0;
+
+    e1000_w(E1000_RCTL, E1000_RCTL_EN | E1000_RCTL_UPE | E1000_RCTL_BAM | E1000_RCTL_SECRC);
+
+    for (int i = 0; i < E1000_NTX; i++) {
+        dev->txb[i] = (uint8_t*)e1000_alloc16(E1000_BUF);
+        if (!dev->txb[i]) return 0;
+        dev->tx[i].addr_lo = (uint32_t)virt_to_phys(dev->txb[i]);
+        dev->tx[i].addr_hi = 0;
+        dev->tx[i].cmd = 0;
+        dev->tx[i].status = E1000_TXD_STAT_DD;
+    }
+    e1000_w(E1000_TDBAL, (uint32_t)virt_to_phys(dev->tx));
+    e1000_w(E1000_TDBAH, 0);
+    e1000_w(E1000_TDLEN, sizeof(struct e1000_txd) * E1000_NTX);
+    e1000_w(E1000_TDH, 0);
+    e1000_w(E1000_TDT, 0);
+    dev->tx_tail = 0;
+
+    e1000_w(E1000_TCTL, E1000_TCTL_EN | E1000_TCTL_PSP | (15u << 4) | (64u << 12));
+    e1000_w(E1000_TIPG, 10 | (8u << 10) | (6u << 20));
+
+    e1000_read_link();
+    return 1;
+}
+
+static void e1000_send_frame(const uint8_t* data, uint32_t len) {
+    e1000_dev_t* dev = &e1000_dev;
+    struct e1000_txd* d = &dev->tx[dev->tx_tail];
+    for (int i = 0; i < 20 && !(d->status & E1000_TXD_STAT_DD); i++) delay_ms(1);
+    if (!(d->status & E1000_TXD_STAT_DD)) return;
+    if (len > E1000_BUF) len = E1000_BUF;
+    memcpy(dev->txb[dev->tx_tail], data, len);
+    if (len < 60) { memset(dev->txb[dev->tx_tail] + len, 0, 60 - len); len = 60; }
+    d->length = (uint16_t)len;
+    d->cso = 0;
+    d->css = 0;
+    d->special = 0;
+    d->status = 0;
+    d->cmd = E1000_TXD_CMD_EOP | E1000_TXD_CMD_IFCS | E1000_TXD_CMD_RS;
+    dev->tx_tail = (dev->tx_tail + 1) % E1000_NTX;
+    e1000_w(E1000_TDT, (uint32_t)dev->tx_tail);
+}
+
+static void e1000_poll(void) {
+    e1000_dev_t* dev = &e1000_dev;
+    (void)e1000_r(E1000_ICR);
+    for (int n = 0; n < E1000_NRX; n++) {
+        struct e1000_rxd* d = &dev->rx[dev->rx_head];
+        if (!(d->status & E1000_RXD_STAT_DD)) break;
+        uint32_t len = d->length;
+        if ((d->status & E1000_RXD_STAT_EOP) && !d->errors && len >= 14 && len <= 1514)
+            netdev_rx_submit(dev->rxb[dev->rx_head], len);
+        d->status = 0;
+        e1000_w(E1000_RDT, (uint32_t)dev->rx_head);
+        dev->rx_head = (dev->rx_head + 1) % E1000_NRX;
+    }
+    if (uptime_ticks - dev->last_link_tick >= 250) {
+        dev->last_link_tick = uptime_ticks;
+        e1000_read_link();
+    }
+}
+
+static int e1000_is_supported(uint16_t did) {
+    static const uint16_t ids[] = {
+        0x100E, 0x100F, 0x1010, 0x1011, 0x1012, 0x1013, 0x1015, 0x1016, 0x1017,
+        0x1018, 0x1019, 0x101A, 0x101D, 0x101E, 0x1026, 0x1027, 0x1028, 0x1075,
+        0x1076, 0x1077, 0x1078, 0x1079, 0x107A, 0x107B, 0x107C, 0x108A, 0x1099,
+        0x10B5, 0x10D3,
+        0x1502, 0x1503,
+    };
+    for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++)
+        if (ids[i] == did) return 1;
+    return 0;
+}
+
+static int e1000_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    if (vendor != 0x8086 || !e1000_is_supported(device)) return 0;
+
+    uint32_t bar0 = pci_config_read(bus, slot, func, 0x10);
+    if (bar0 & 1) return 0;
+
+    e1000_dev_t* dev = &e1000_dev;
+    memset(dev, 0, sizeof(*dev));
+    net_pci_enable(bus, slot, func, 0x6);
+    dev->mmio = (uintptr_t)(bar0 & 0xFFFFFFF0);
+    dev->pch2 = (device == 0x1502 || device == 0x1503);
+    return e1000_init_chip();
+}
+
+static const net_dev_t e1000_driver = {
+    "Intel 8254x (e1000)",
+    0x8086, 0x100E,
+    e1000_send_frame,
+    e1000_poll,
+    e1000_probe
+};
+
+const net_dev_t* e1000_driver_get(void) { return &e1000_driver; }
diff --git a/src/net/drivers/ne2000.c b/src/net/drivers/ne2000.c
new file mode 100644
index 0000000..2688c79
--- /dev/null
+++ b/src/net/drivers/ne2000.c
@@ -0,0 +1,198 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/ne2000.h"
+
+#define NE_CR    0x00
+#define NE_PSTART 0x01
+#define NE_PSTOP 0x02
+#define NE_BNRY  0x03
+#define NE_TPSR  0x04
+#define NE_TBCR0 0x05
+#define NE_TBCR1 0x06
+#define NE_ISR   0x07
+#define NE_RSAR0 0x08
+#define NE_RSAR1 0x09
+#define NE_RBCR0 0x0A
+#define NE_RBCR1 0x0B
+#define NE_IMR   0x0F
+#define NE_RCR   0x0C
+#define NE_TCR   0x0D
+#define NE_DCR   0x0E
+#define NE_DATA  0x10
+#define NE_RESET 0x1F
+
+#define NE_PAGE_RX_START 0x46
+#define NE_PAGE_RX_END   0x60
+#define NE_PAGE_TX       0x40
+
+#define NE_CR_STOP 0x01
+#define NE_CR_START 0x02
+#define NE_CR_TXP 0x04
+#define NE_CR_RD2 0x20
+#define NE_CR_PS0 0x00
+#define NE_CR_PS1 0x40
+#define NE_ISR_PTX 0x08
+#define NE_ISR_PRX 0x01
+#define NE_ISR_RDC 0x40
+
+typedef struct {
+    uint16_t iobase;
+    uint8_t  scratch[2048];
+} ne2000_dev_t;
+
+static ne2000_dev_t ne_dev;
+
+static void ne_remote_read(uint8_t page, uint16_t off, uint8_t* dst, uint16_t len) {
+    uint16_t addr = (uint16_t)(((uint16_t)page << 8) | off);
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+    outb(ne_dev.iobase + NE_RBCR0, (uint8_t)(len & 0xFF));
+    outb(ne_dev.iobase + NE_RBCR1, (uint8_t)(len >> 8));
+    outb(ne_dev.iobase + NE_RSAR0, (uint8_t)(addr & 0xFF));
+    outb(ne_dev.iobase + NE_RSAR1, (uint8_t)(addr >> 8));
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_START | NE_CR_PS0);
+    for (uint16_t i = 0; i < len; i += 2) {
+        uint16_t w = inw(ne_dev.iobase + NE_DATA);
+        dst[i] = (uint8_t)(w & 0xFF);
+        if (i + 1 < len) dst[i + 1] = (uint8_t)(w >> 8);
+    }
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+}
+
+static void ne_remote_write(uint8_t page, uint16_t off, const uint8_t* src, uint16_t len) {
+    uint16_t addr = (uint16_t)(((uint16_t)page << 8) | off);
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+    outb(ne_dev.iobase + NE_RBCR0, (uint8_t)(len & 0xFF));
+    outb(ne_dev.iobase + NE_RBCR1, (uint8_t)(len >> 8));
+    outb(ne_dev.iobase + NE_RSAR0, (uint8_t)(addr & 0xFF));
+    outb(ne_dev.iobase + NE_RSAR1, (uint8_t)(addr >> 8));
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_START | NE_CR_PS1);
+    for (uint16_t i = 0; i < len; i += 2) {
+        uint16_t w = src[i] | ((i + 1 < len) ? ((uint16_t)src[i + 1] << 8) : 0);
+        outw(ne_dev.iobase + NE_DATA, w);
+    }
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+}
+
+static void ne_wait_rdc(void) {
+    for (int i = 0; i < 10000 && !(inb(ne_dev.iobase + NE_ISR) & NE_ISR_RDC); i++) { }
+    outb(ne_dev.iobase + NE_ISR, NE_ISR_RDC);
+}
+
+static void ne_send_frame(const uint8_t* data, uint32_t len) {
+    if (len > 1500) len = 1500;
+    uint32_t plen = len < 60 ? 60 : len;
+    if (plen & 1) plen++;
+    memcpy(ne_dev.scratch, data, len);
+    memset(ne_dev.scratch + len, 0, plen - len);
+
+    ne_remote_write(NE_PAGE_TX, 0, ne_dev.scratch, (uint16_t)plen);
+    ne_wait_rdc();
+
+    outb(ne_dev.iobase + NE_TPSR, NE_PAGE_TX);
+    outb(ne_dev.iobase + NE_TBCR0, (uint8_t)(plen & 0xFF));
+    outb(ne_dev.iobase + NE_TBCR1, (uint8_t)(plen >> 8));
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_TXP | NE_CR_START | NE_CR_PS0);
+
+    for (int i = 0; i < 10000 && !(inb(ne_dev.iobase + NE_ISR) & NE_ISR_PTX); i++) { }
+    outb(ne_dev.iobase + NE_ISR, NE_ISR_PTX);
+}
+
+static void ne_poll(void) {
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+
+    uint8_t curr = 0;
+    uint8_t ps1 = (uint8_t)(NE_CR_RD2 | NE_CR_STOP | NE_CR_PS1);
+    outb(ne_dev.iobase + NE_CR, ps1);
+    curr = inb(ne_dev.iobase + NE_CR + 7);
+
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+    uint8_t bnry = inb(ne_dev.iobase + NE_BNRY);
+
+    uint8_t page = (uint8_t)(bnry + 1);
+    if (page >= NE_PAGE_RX_END) page = NE_PAGE_RX_START;
+
+    int guard = 0;
+    while (page != curr && guard++ < 64) {
+        uint8_t hdr[4];
+        ne_remote_read(page, 0, hdr, 4);
+        uint8_t  next = hdr[1];
+        uint16_t flen = (uint16_t)(hdr[2] | ((uint16_t)hdr[3] << 8));
+        uint8_t  status = hdr[0];
+
+        if (next <= NE_PAGE_RX_START || next >= NE_PAGE_RX_END) break;
+        if ((status & NE_ISR_PRX) && flen >= 14 + 4 && flen <= 1518) {
+            ne_remote_read(page, 4, ne_dev.scratch, flen);
+            netdev_rx_submit(ne_dev.scratch, (uint32_t)(flen - 4));
+        }
+
+        bnry = (uint8_t)(next - 1);
+        if (bnry < NE_PAGE_RX_START) bnry = NE_PAGE_RX_END - 1;
+        outb(ne_dev.iobase + NE_BNRY, bnry);
+        page = next;
+    }
+
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_START | NE_CR_PS0);
+}
+
+static void ne_read_station_address(uint8_t mac[6]) {
+    ne_remote_read(0x00, 0x00, mac, 6);
+}
+
+static int ne2000_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    (void)vendor;
+    if (device != 0x8029 && device != 0x0940) return 0;
+
+    uint32_t bar0 = pci_config_read(bus, slot, func, 0x10);
+    if (!(bar0 & 1)) return 0;
+
+    memset(&ne_dev, 0, sizeof(ne_dev));
+    ne_dev.iobase = (uint16_t)(bar0 & 0xFFFC);
+    net_pci_enable(bus, slot, func, 0x1);
+
+    (void)inb(ne_dev.iobase + NE_RESET);
+    for (volatile int i = 0; i < 200000; i++) { }
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS0);
+    for (volatile int i = 0; i < 200000; i++) { }
+
+    outb(ne_dev.iobase + NE_DCR, 0x49);
+
+    uint8_t mac[6];
+    ne_read_station_address(mac);
+    netdev_set_mac(mac);
+
+    outb(ne_dev.iobase + NE_RBCR0, 0x00);
+    outb(ne_dev.iobase + NE_RBCR1, 0x00);
+    outb(ne_dev.iobase + NE_RCR, 0x06);
+    outb(ne_dev.iobase + NE_TCR, 0x02);
+    outb(ne_dev.iobase + NE_PSTART, NE_PAGE_RX_START);
+    outb(ne_dev.iobase + NE_PSTOP, NE_PAGE_RX_END);
+    outb(ne_dev.iobase + NE_BNRY, NE_PAGE_RX_START);
+    outb(ne_dev.iobase + NE_ISR, 0xFF);
+    outb(ne_dev.iobase + NE_IMR, 0x00);
+
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_STOP | NE_CR_PS1);
+    for (int i = 0; i < 6; i++) outb(ne_dev.iobase + NE_PSTART + i, mac[i]);
+    outb(ne_dev.iobase + NE_CR + 7, NE_PAGE_RX_START + 1);
+    for (int i = 0; i < 8; i++) outb(ne_dev.iobase + NE_RSAR0 + i, 0x00);
+    outb(ne_dev.iobase + NE_CR, NE_CR_RD2 | NE_CR_START | NE_CR_PS0);
+    outb(ne_dev.iobase + NE_TCR, 0x00);
+    outb(ne_dev.iobase + NE_ISR, 0xFF);
+
+    netdev_report_link(1);
+    netdev_set_name(device == 0x8029 ? "Realtek RTL8029 (NE2000)"
+                                     : "NE2000-compatible");
+    return 1;
+}
+
+static const net_dev_t ne2000_driver = {
+    "NE2000 compatible",
+    0x10EC, 0x8029,
+    ne_send_frame,
+    ne_poll,
+    ne2000_probe
+};
+
+const net_dev_t* ne2000_driver_get(void) { return &ne2000_driver; }
diff --git a/src/net/drivers/pcnet.c b/src/net/drivers/pcnet.c
new file mode 100644
index 0000000..921b3ae
--- /dev/null
+++ b/src/net/drivers/pcnet.c
@@ -0,0 +1,243 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/pcnet.h"
+
+#define PN_RDP       0x10
+#define PN_RAP       0x14
+#define PN_RESET     0x18
+#define PN_BDP       0x1C
+#define PN_WIO_RESET 0x14
+
+#define CSR0_INIT 0x0001
+#define CSR0_STRT 0x0002
+#define CSR0_STOP 0x0004
+#define CSR0_TDMD 0x0008
+#define CSR0_IENA 0x0040
+#define CSR0_IDON 0x0100
+#define CSR0_TINT 0x0200
+#define CSR0_RINT 0x0400
+#define CSR0_MISS 0x1000
+
+#define PD_OWN  0x80000000u
+#define PD_ERR  0x40000000u
+#define PD_STP  0x02000000u
+#define PD_ENP  0x01000000u
+#define PD_ONES 0x0000F000u
+#define PD_BCNT(n) (((uint32_t)(-(int32_t)(n))) & 0x0FFFu)
+
+#define PN_TX      8
+#define PN_RX      16
+#define PN_BUF     1536
+#define PN_LOG2_TX 3
+#define PN_LOG2_RX 4
+
+struct pn_desc {
+    uint32_t addr;
+    uint32_t status;
+    uint32_t misc;
+    uint32_t user;
+} __attribute__((packed));
+
+struct pn_initblk {
+    uint16_t mode;
+    uint8_t  rlen;
+    uint8_t  tlen;
+    uint8_t  padr[6];
+    uint16_t reserved;
+    uint8_t  ladrf[8];
+    uint32_t rdra;
+    uint32_t tdra;
+} __attribute__((packed));
+
+typedef struct {
+    uint32_t         iobase;
+    uintptr_t        mmio;
+    uint8_t          mac[6];
+    struct pn_desc*  tx;
+    struct pn_desc*  rx;
+    uint8_t*         txb[PN_TX];
+    uint8_t*         rxb[PN_RX];
+    struct pn_initblk* ib;
+    int              rx_next;
+    int              tx_next;
+    uint32_t         last_link_tick;
+} pcnet_dev_t;
+
+static pcnet_dev_t pcnet_dev;
+
+static void pn_w32(pcnet_dev_t* dev, uint32_t off, uint32_t v) {
+    if (dev->mmio) *(volatile uint32_t*)(dev->mmio + off) = v;
+    else outl(dev->iobase + off, v);
+}
+
+static uint32_t pn_r32(pcnet_dev_t* dev, uint32_t off) {
+    if (dev->mmio) return *(volatile uint32_t*)(dev->mmio + off);
+    return inl(dev->iobase + off);
+}
+
+static void pn_csrw(pcnet_dev_t* dev, int c, uint32_t v) {
+    pn_w32(dev, PN_RAP, (uint32_t)c);
+    pn_w32(dev, PN_RDP, v);
+}
+
+static uint32_t pn_csrr(pcnet_dev_t* dev, int c) {
+    pn_w32(dev, PN_RAP, (uint32_t)c);
+    return pn_r32(dev, PN_RDP) & 0xFFFF;
+}
+
+static void pn_bcrw(pcnet_dev_t* dev, int c, uint32_t v) {
+    pn_w32(dev, PN_RAP, (uint32_t)c);
+    pn_w32(dev, PN_BDP, v);
+}
+
+static uint32_t pn_bcrr(pcnet_dev_t* dev, int c) {
+    pn_w32(dev, PN_RAP, (uint32_t)c);
+    return pn_r32(dev, PN_BDP) & 0xFFFF;
+}
+
+static void* pn_alloc16(uint32_t size) {
+    uint8_t* m = (uint8_t*)kmalloc(size + 16);
+    if (!m) return NULL;
+    uintptr_t a = ((uintptr_t)m + 15) & ~(uintptr_t)15;
+    memset((void*)a, 0, size);
+    return (void*)a;
+}
+
+static void pn_read_link(pcnet_dev_t* dev) {
+    uint32_t bcr4 = pn_bcrr(dev, 4);
+    netdev_report_link((bcr4 & 0x0040) ? ((bcr4 & 0x8000) ? 1 : 0) : 1);
+}
+
+static int pn_init_chip(pcnet_dev_t* dev) {
+    (void)pn_r32(dev, PN_RESET);
+    if (dev->mmio) (void)*(volatile uint16_t*)(dev->mmio + PN_WIO_RESET);
+    else (void)inw(dev->iobase + PN_WIO_RESET);
+    delay_ms(2);
+
+    pn_w32(dev, PN_RDP, 0);
+
+    for (int i = 0; i < 6; i++) {
+        if (dev->mmio) dev->mac[i] = *(volatile uint8_t*)(dev->mmio + i);
+        else dev->mac[i] = inb(dev->iobase + i);
+    }
+    netdev_set_mac(dev->mac);
+
+    pn_bcrw(dev, 20, 0x0002);
+
+    dev->ib = (struct pn_initblk*)pn_alloc16(sizeof(*dev->ib));
+    dev->tx = (struct pn_desc*)pn_alloc16(sizeof(struct pn_desc) * PN_TX);
+    dev->rx = (struct pn_desc*)pn_alloc16(sizeof(struct pn_desc) * PN_RX);
+    if (!dev->ib || !dev->tx || !dev->rx) return 0;
+
+    for (int i = 0; i < PN_TX; i++) {
+        dev->txb[i] = (uint8_t*)pn_alloc16(PN_BUF);
+        if (!dev->txb[i]) return 0;
+        dev->tx[i].addr = (uint32_t)virt_to_phys(dev->txb[i]);
+        dev->tx[i].status = PD_ONES;
+        dev->tx[i].misc = 0;
+    }
+    for (int i = 0; i < PN_RX; i++) {
+        dev->rxb[i] = (uint8_t*)pn_alloc16(PN_BUF);
+        if (!dev->rxb[i]) return 0;
+        dev->rx[i].addr = (uint32_t)virt_to_phys(dev->rxb[i]);
+        dev->rx[i].status = PD_OWN | PD_ONES | PD_BCNT(PN_BUF);
+        dev->rx[i].misc = 0;
+    }
+    dev->rx_next = 0;
+    dev->tx_next = 0;
+
+    dev->ib->mode = 0x8000;
+    dev->ib->rlen = (uint8_t)(PN_LOG2_RX << 4);
+    dev->ib->tlen = (uint8_t)(PN_LOG2_TX << 4);
+    for (int i = 0; i < 6; i++) dev->ib->padr[i] = dev->mac[i];
+    for (int i = 0; i < 8; i++) dev->ib->ladrf[i] = 0;
+    dev->ib->rdra = (uint32_t)virt_to_phys(dev->rx);
+    dev->ib->tdra = (uint32_t)virt_to_phys(dev->tx);
+
+    uint32_t ib = (uint32_t)virt_to_phys(dev->ib);
+    pn_csrw(dev, 1, ib & 0xFFFF);
+    pn_csrw(dev, 2, ib >> 16);
+    pn_csrw(dev, 3, 0x5F00);
+    pn_csrw(dev, 4, 0x0915);
+
+    pn_csrw(dev, 0, CSR0_INIT);
+    int ok = 0;
+    for (int t = 0; t < 1000; t++) {
+        if (pn_csrr(dev, 0) & CSR0_IDON) { ok = 1; break; }
+        delay_ms(1);
+    }
+    if (!ok) return 0;
+    pn_csrw(dev, 0, CSR0_IDON | CSR0_STRT);
+    pn_read_link(dev);
+    return 1;
+}
+
+static void pn_send_frame(const uint8_t* data, uint32_t len) {
+    pcnet_dev_t* dev = &pcnet_dev;
+    struct pn_desc* d = &dev->tx[dev->tx_next];
+
+    for (int i = 0; i < 20 && (d->status & PD_OWN); i++) delay_ms(1);
+    if (d->status & PD_OWN) return;
+    if (len > PN_BUF) len = PN_BUF;
+    memcpy(dev->txb[dev->tx_next], data, len);
+    if (len < 60) { memset(dev->txb[dev->tx_next] + len, 0, 60 - len); len = 60; }
+    d->misc = 0;
+    d->status = PD_OWN | PD_STP | PD_ENP | PD_ONES | PD_BCNT(len);
+    pn_csrw(dev, 0, CSR0_TDMD);
+    dev->tx_next = (dev->tx_next + 1) % PN_TX;
+}
+
+static void pn_poll(void) {
+    pcnet_dev_t* dev = &pcnet_dev;
+
+    uint32_t csr0 = pn_csrr(dev, 0);
+    if (csr0 & 0x7F00) pn_csrw(dev, 0, csr0 & 0x7F00);
+
+    for (int n = 0; n < PN_RX; n++) {
+        struct pn_desc* d = &dev->rx[dev->rx_next];
+        if (d->status & PD_OWN) break;
+        uint32_t st = d->status;
+        uint32_t mcnt = d->misc & 0x0FFF;
+        if (!(st & PD_ERR) && (st & PD_STP) && (st & PD_ENP) &&
+            mcnt > 18 && mcnt <= PN_BUF)
+            netdev_rx_submit(dev->rxb[dev->rx_next], mcnt - 4);
+        d->misc = 0;
+        d->status = PD_OWN | PD_ONES | PD_BCNT(PN_BUF);
+        dev->rx_next = (dev->rx_next + 1) % PN_RX;
+    }
+
+    if (uptime_ticks - dev->last_link_tick >= 500) {
+        dev->last_link_tick = uptime_ticks;
+        pn_read_link(dev);
+    }
+}
+
+static int pcnet_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    if (vendor != 0x1022 || (device != 0x2000 && device != 0x2001)) return 0;
+
+    pcnet_dev_t* dev = &pcnet_dev;
+    memset(dev, 0, sizeof(*dev));
+    uint32_t bar0 = pci_config_read(bus, slot, func, 0x10);
+    net_pci_enable(bus, slot, func, 0x7);
+    if (bar0 & 0x1) {
+        dev->iobase = bar0 & 0xFFFFFFFC;
+        dev->mmio = 0;
+    } else {
+        dev->mmio = (uintptr_t)(bar0 & 0xFFFFFFF0);
+        dev->iobase = 0;
+    }
+    return pn_init_chip(dev);
+}
+
+static const net_dev_t pcnet_driver = {
+    "AMD PCnet-PCI",
+    0x1022, 0x2000,
+    pn_send_frame,
+    pn_poll,
+    pcnet_probe
+};
+
+const net_dev_t* pcnet_driver_get(void) { return &pcnet_driver; }
diff --git a/src/net/drivers/r8169.c b/src/net/drivers/r8169.c
new file mode 100644
index 0000000..cc7a359
--- /dev/null
+++ b/src/net/drivers/r8169.c
@@ -0,0 +1,197 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/r8169.h"
+
+#define R8169_NRX 64
+#define R8169_NTX 32
+#define R8169_BUF 2048
+
+#define R8169_DESC_OWN 0x80000000u
+#define R8169_DESC_EOR 0x40000000u
+#define R8169_DESC_FS  0x20000000u
+#define R8169_DESC_LS  0x10000000u
+
+#define R8169_IDR0   0x00
+#define R8169_TNPDS  0x20
+#define R8169_CMD    0x37
+#define R8169_TPPOLL 0x38
+#define R8169_IMR    0x3C
+#define R8169_ISR    0x3E
+#define R8169_TCR    0x40
+#define R8169_RCR    0x44
+#define R8169_RDSAR  0xE4
+
+#define R8169_CMD_RST 0x10
+#define R8169_CMD_RE  0x08
+#define R8169_CMD_TE  0x04
+
+#define R8169_TPPOLL_NPQ 0x40
+#define R8169_RCR_VALUE  0x0000E70F
+#define R8169_TCR_VALUE  0x03000700
+#define R8169_RX_BUF_BITS 0x00001FF8u
+
+typedef struct {
+    uint32_t status;
+    uint32_t vlan;
+    uint32_t addr_lo;
+    uint32_t addr_hi;
+} __attribute__((packed)) r8169_desc_t;
+
+typedef struct {
+    uintptr_t mmio;
+    uint32_t  iobase;
+    r8169_desc_t* rx;
+    r8169_desc_t* tx;
+    uint8_t* rxb[R8169_NRX];
+    uint8_t* txb[R8169_NTX];
+    uint32_t rx_head;
+    uint32_t tx_head;
+} r8169_dev_t;
+
+static r8169_dev_t r8169_dev;
+
+static void r8169_w8(uint32_t off, uint8_t v) {
+    if (r8169_dev.mmio) *(volatile uint8_t*)(r8169_dev.mmio + off) = v;
+    else outb((uint16_t)(r8169_dev.iobase + off), v);
+}
+
+static uint8_t r8169_r8(uint32_t off) {
+    return r8169_dev.mmio ? *(volatile uint8_t*)(r8169_dev.mmio + off)
+                          : inb((uint16_t)(r8169_dev.iobase + off));
+}
+
+static void r8169_w16(uint32_t off, uint16_t v) {
+    if (r8169_dev.mmio) *(volatile uint16_t*)(r8169_dev.mmio + off) = v;
+    else outw((uint16_t)(r8169_dev.iobase + off), v);
+}
+
+static void r8169_w32(uint32_t off, uint32_t v) {
+    if (r8169_dev.mmio) *(volatile uint32_t*)(r8169_dev.mmio + off) = v;
+    else outl((uint16_t)(r8169_dev.iobase + off), v);
+}
+
+static void r8169_send_frame(const uint8_t* data, uint32_t len) {
+    r8169_dev_t* dev = &r8169_dev;
+    uint32_t idx = dev->tx_head;
+    volatile r8169_desc_t* d = &dev->tx[idx];
+
+    for (int i = 0; i < 20 && (d->status & R8169_DESC_OWN); i++) delay_ms(1);
+    if (d->status & R8169_DESC_OWN) return;
+
+    if (len > R8169_BUF) len = R8169_BUF;
+    memcpy(dev->txb[idx], data, len);
+    if (len < 60) { memset(dev->txb[idx] + len, 0, 60 - len); len = 60; }
+
+    d->addr_lo = (uint32_t)virt_to_phys(dev->txb[idx]);
+    d->addr_hi = 0;
+    d->vlan = 0;
+    d->status = R8169_DESC_OWN | R8169_DESC_FS | R8169_DESC_LS | len |
+                (idx == R8169_NTX - 1 ? R8169_DESC_EOR : 0);
+    dev->tx_head = (idx + 1) & (R8169_NTX - 1);
+    asm volatile("" ::: "memory");
+    r8169_w8(R8169_TPPOLL, R8169_TPPOLL_NPQ);
+}
+
+static void r8169_poll(void) {
+    r8169_dev_t* dev = &r8169_dev;
+    for (int n = 0; n < R8169_NRX; n++) {
+        uint32_t idx = dev->rx_head;
+        volatile r8169_desc_t* d = &dev->rx[idx];
+        if (d->status & R8169_DESC_OWN) break;
+        uint32_t status = d->status;
+        uint32_t len = status & 0x3FFF;
+        if ((status & (R8169_DESC_FS | R8169_DESC_LS)) == (R8169_DESC_FS | R8169_DESC_LS) &&
+            len >= 18 && len <= R8169_BUF)
+            netdev_rx_submit(dev->rxb[idx], len - 4);
+        d->status = R8169_DESC_OWN | R8169_RX_BUF_BITS |
+                    (idx == R8169_NRX - 1 ? R8169_DESC_EOR : 0);
+        dev->rx_head = (idx + 1) & (R8169_NRX - 1);
+    }
+}
+
+static int r8169_init(uint8_t bus, uint8_t slot, uint8_t func, uint16_t device) {
+    r8169_dev_t* dev = &r8169_dev;
+    uint32_t bar0 = pci_config_read(bus, slot, func, 0x10);
+    uint32_t bar1 = pci_config_read(bus, slot, func, 0x14);
+    net_pci_enable(bus, slot, func, 0x7);
+
+    dev->mmio = 0;
+    dev->iobase = 0;
+    if (bar0 & 1) {
+        dev->iobase = bar0 & 0xFFFFFFFC;
+    } else {
+        uint64_t address = bar0 & 0xFFFFFFF0;
+        if ((bar0 & 6) == 4) address |= (uint64_t)bar1 << 32;
+        if (!address || address >= 137438953472ULL) return 0;
+#ifdef SHARKOS_32BIT
+        if (address > 0xFFFFFFFFULL) return 0;
+#endif
+        dev->mmio = (uintptr_t)address;
+    }
+
+    r8169_w8(R8169_CMD, R8169_CMD_RST);
+    for (int i = 0; i < 100 && (r8169_r8(R8169_CMD) & R8169_CMD_RST); i++) delay_ms(1);
+    if (r8169_r8(R8169_CMD) & R8169_CMD_RST) return 0;
+
+    uint8_t mac[6];
+    for (int i = 0; i < 6; i++) mac[i] = r8169_r8(R8169_IDR0 + (uint32_t)i);
+    netdev_set_mac(mac);
+
+    dev->rx = (r8169_desc_t*)kmalloc(sizeof(r8169_desc_t) * R8169_NRX + 256);
+    dev->tx = (r8169_desc_t*)kmalloc(sizeof(r8169_desc_t) * R8169_NTX + 256);
+    if (!dev->rx || !dev->tx) return 0;
+    dev->rx = (r8169_desc_t*)(((uintptr_t)dev->rx + 255) & ~(uintptr_t)255);
+    dev->tx = (r8169_desc_t*)(((uintptr_t)dev->tx + 255) & ~(uintptr_t)255);
+    memset(dev->rx, 0, sizeof(r8169_desc_t) * R8169_NRX);
+    memset(dev->tx, 0, sizeof(r8169_desc_t) * R8169_NTX);
+    if (virt_to_phys(dev->rx) > 0xFFFFFFFFu || virt_to_phys(dev->tx) > 0xFFFFFFFFu) return 0;
+
+    for (int i = 0; i < R8169_NRX; i++) {
+        dev->rxb[i] = (uint8_t*)kmalloc(R8169_BUF);
+        if (!dev->rxb[i] || virt_to_phys(dev->rxb[i]) > 0xFFFFFFFFu) return 0;
+        dev->rx[i].addr_lo = (uint32_t)virt_to_phys(dev->rxb[i]);
+        dev->rx[i].status = R8169_DESC_OWN | R8169_RX_BUF_BITS |
+                            (i == R8169_NRX - 1 ? R8169_DESC_EOR : 0);
+    }
+    for (int i = 0; i < R8169_NTX; i++) {
+        dev->txb[i] = (uint8_t*)kmalloc(R8169_BUF);
+        if (!dev->txb[i] || virt_to_phys(dev->txb[i]) > 0xFFFFFFFFu) return 0;
+        dev->tx[i].addr_lo = (uint32_t)virt_to_phys(dev->txb[i]);
+    }
+    dev->rx_head = 0;
+    dev->tx_head = 0;
+
+    r8169_w32(R8169_RDSAR, (uint32_t)virt_to_phys(dev->rx));
+    r8169_w32(R8169_RDSAR + 4, 0);
+    r8169_w32(R8169_TNPDS, (uint32_t)virt_to_phys(dev->tx));
+    r8169_w32(R8169_TNPDS + 4, 0);
+    r8169_w16(R8169_IMR, 0);
+    r8169_w16(R8169_ISR, 0xFFFF);
+    r8169_w32(R8169_RCR, R8169_RCR_VALUE);
+    r8169_w32(R8169_TCR, R8169_TCR_VALUE);
+    r8169_w8(R8169_CMD, R8169_CMD_RE | R8169_CMD_TE);
+
+    netdev_report_link(1);
+    netdev_set_name(device == 0x8169 ? "Realtek RTL8169"
+                                     : "Realtek RTL8111/8168/8211/8411");
+    return 1;
+}
+
+static int r8169_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    if (vendor != 0x10EC || (device != 0x8168 && device != 0x8169)) return 0;
+    memset(&r8169_dev, 0, sizeof(r8169_dev));
+    return r8169_init(bus, slot, func, device);
+}
+
+static const net_dev_t r8169_driver = {
+    "Realtek RTL8169/8111",
+    0x10EC, 0x8168,
+    r8169_send_frame,
+    r8169_poll,
+    r8169_probe
+};
+
+const net_dev_t* r8169_driver_get(void) { return &r8169_driver; }
diff --git a/src/net/drivers/rtl8139.c b/src/net/drivers/rtl8139.c
new file mode 100644
index 0000000..b708b17
--- /dev/null
+++ b/src/net/drivers/rtl8139.c
@@ -0,0 +1,170 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/rtl8139.h"
+
+#define RTL_RX_SIZE 8192
+#define RTL_TX_N    4
+#define RTL_TX_MAX  1792
+
+#define RTL_IDR0    0x00
+#define RTL_TSD0    0x10
+#define RTL_TSAD0   0x20
+#define RTL_RBSTART 0x30
+#define RTL_CR      0x37
+#define RTL_CAPR    0x38
+#define RTL_CBR     0x3A
+#define RTL_IMR     0x3C
+#define RTL_ISR     0x3E
+#define RTL_TCR     0x40
+#define RTL_RCR     0x44
+#define RTL_9346CR  0x50
+#define RTL_CONFIG1 0x52
+#define RTL_MSR     0x58
+#define RTL_BMCR    0x62
+#define RTL_BMSR    0x64
+
+#define RTL_CR_RST  0x10
+#define RTL_CR_RE   0x08
+#define RTL_CR_TE   0x04
+#define RTL_CR_BUFE 0x01
+
+#define RTL_ISR_ROK  0x0001
+#define RTL_ISR_RER  0x0002
+#define RTL_ISR_TOK  0x0004
+#define RTL_ISR_TER  0x0008
+#define RTL_ISR_RXOVW 0x0010
+#define RTL_ISR_FOVW  0x0040
+
+#define RTL_TSD_OWN 0x2000
+
+#define RTL_RCR_VALUE (0x0000000Fu | (1u << 7) | (7u << 8) | (7u << 13))
+#define RTL_TCR_VALUE ((7u << 8) | (3u << 24))
+
+typedef struct {
+    uint16_t iobase;
+    uint8_t* rx_ring;
+    uint32_t rx_pos;
+    uint32_t tx_next;
+    uint8_t tx_buf[RTL_TX_MAX + 8] __attribute__((aligned(16)));
+    uint8_t mac[6];
+} rtl8139_dev_t;
+
+static rtl8139_dev_t rtl_dev;
+
+static void rtl_reset(rtl8139_dev_t* dev) {
+    outb(dev->iobase + RTL_CONFIG1, 0x00);
+    outb(dev->iobase + RTL_CR, RTL_CR_RST);
+    for (int i = 0; i < 1000; i++) {
+        if ((inb(dev->iobase + RTL_CR) & RTL_CR_RST) == 0) break;
+        delay_ms(1);
+    }
+}
+
+static void rtl_read_link(rtl8139_dev_t* dev) {
+    uint8_t msr = inb(dev->iobase + RTL_MSR);
+    netdev_report_link((msr & 0x04) ? 0 : 1);
+}
+
+static int rtl_init_chip(rtl8139_dev_t* dev) {
+    dev->rx_ring = (uint8_t*)kmalloc(RTL_RX_SIZE + 16 + 1536);
+    if (!dev->rx_ring) return 0;
+    memset(dev->rx_ring, 0, RTL_RX_SIZE + 16 + 1536);
+    dev->rx_pos = 0;
+    dev->tx_next = 0;
+
+    for (int i = 0; i < 6; i++) dev->mac[i] = inb(dev->iobase + RTL_IDR0 + i);
+    netdev_set_mac(dev->mac);
+
+    outl(dev->iobase + RTL_RBSTART, (uint32_t)virt_to_phys(dev->rx_ring));
+    outb(dev->iobase + RTL_CR, RTL_CR_RE | RTL_CR_TE);
+    outl(dev->iobase + RTL_RCR, RTL_RCR_VALUE);
+    outl(dev->iobase + RTL_TCR, RTL_TCR_VALUE);
+
+    outw(dev->iobase + RTL_ISR, 0xFFFF);
+    outw(dev->iobase + RTL_IMR, 0);
+    outw(dev->iobase + RTL_CAPR, (uint16_t)(0 - 16));
+
+    rtl_read_link(dev);
+    return 1;
+}
+
+static uint16_t rtl_tsd(rtl8139_dev_t* dev) {
+    return inl(dev->iobase + RTL_TSD0 + dev->tx_next * 4) & 0xFFFF;
+}
+
+static void rtl_send_frame(const uint8_t* data, uint32_t len) {
+    rtl8139_dev_t* dev = &rtl_dev;
+    if (len > RTL_TX_MAX) len = RTL_TX_MAX;
+    for (int i = 0; i < 20 && !(rtl_tsd(dev) & RTL_TSD_OWN); i++) delay_ms(1);
+
+    memcpy(dev->tx_buf, data, len);
+    while (len < 60) dev->tx_buf[len++] = 0;
+
+    outl(dev->iobase + RTL_TSAD0 + dev->tx_next * 4, (uint32_t)virt_to_phys(dev->tx_buf));
+    outl(dev->iobase + RTL_TSD0 + dev->tx_next * 4, len & 0x1FFF);
+    dev->tx_next = (dev->tx_next + 1) % RTL_TX_N;
+}
+
+static void rtl_rx_reset(rtl8139_dev_t* dev) {
+    outb(dev->iobase + RTL_CR, RTL_CR_TE);
+    outb(dev->iobase + RTL_CR, RTL_CR_RE | RTL_CR_TE);
+    outl(dev->iobase + RTL_RCR, RTL_RCR_VALUE);
+    dev->rx_pos = 0;
+    outw(dev->iobase + RTL_CAPR, (uint16_t)(0 - 16));
+    outw(dev->iobase + RTL_ISR, 0xFFFF);
+}
+
+static void rtl_poll(void) {
+    rtl8139_dev_t* dev = &rtl_dev;
+    uint16_t isr = inw(dev->iobase + RTL_ISR);
+    if (isr) outw(dev->iobase + RTL_ISR, isr);
+    if (isr & (RTL_ISR_RXOVW | RTL_ISR_FOVW)) {
+        rtl_rx_reset(dev);
+        return;
+    }
+
+    int guard = 0;
+    while (!(inb(dev->iobase + RTL_CR) & RTL_CR_BUFE) && guard++ < 64) {
+        const uint8_t* hdr = dev->rx_ring + dev->rx_pos;
+        uint16_t status = (uint16_t)(hdr[0] | (hdr[1] << 8));
+        uint16_t flen   = (uint16_t)(hdr[2] | (hdr[3] << 8));
+
+        if (flen == 0xFFF0) break;
+        if (flen < 4 || flen > 4 + 1514) {
+            rtl_rx_reset(dev);
+            return;
+        }
+        if ((status & RTL_ISR_ROK) && flen >= 4 + 14)
+            netdev_rx_submit(hdr + 4, (uint32_t)flen - 4);
+
+        dev->rx_pos = (dev->rx_pos + 4 + flen + 3) & ~3u;
+        if (dev->rx_pos >= RTL_RX_SIZE) dev->rx_pos -= RTL_RX_SIZE;
+        outw(dev->iobase + RTL_CAPR, (uint16_t)(dev->rx_pos - 16));
+    }
+
+    rtl_read_link(dev);
+}
+
+static int rtl8139_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    if (vendor != 0x10EC || device != 0x8139) return 0;
+
+    rtl8139_dev_t* dev = &rtl_dev;
+    memset(dev, 0, sizeof(*dev));
+    dev->iobase = (uint16_t)(pci_config_read(bus, slot, func, 0x10) & 0xFFFFFFFC);
+    net_pci_enable(bus, slot, func, 0x5);
+    rtl_reset(dev);
+    return rtl_init_chip(dev);
+}
+
+static const net_dev_t rtl8139_driver = {
+    "Realtek RTL8139",
+    0x10EC, 0x8139,
+    rtl_send_frame,
+    rtl_poll,
+    rtl8139_probe
+};
+
+const net_dev_t* rtl8139_driver_get(void) { return &rtl8139_driver; }
diff --git a/src/net/drivers/virtio_net.c b/src/net/drivers/virtio_net.c
new file mode 100644
index 0000000..a8a04c5
--- /dev/null
+++ b/src/net/drivers/virtio_net.c
@@ -0,0 +1,200 @@
+
+
+#include "kernel.h"
+#include "net.h"
+#include "netdev.h"
+#include "drivers/virtio_net.h"
+
+#define VIRTQ_N 32
+#define VIRTQ_BUF 2048
+
+#define VIRTIO_DEV_FEATURES 0x00
+#define VIRTIO_GUEST_FEATURES 0x04
+#define VIRTIO_QUEUE_PFN    0x08
+#define VIRTIO_QUEUE_SIZE   0x0C
+#define VIRTIO_QUEUE_SEL    0x0E
+#define VIRTIO_QUEUE_NOTIFY 0x10
+#define VIRTIO_DEV_STATUS   0x12
+#define VIRTIO_ISR_STATUS   0x13
+#define VIRTIO_CONFIG_OFF   0x14
+
+#define VIRTIO_ST_ACK       0x01
+#define VIRTIO_ST_DRIVER    0x02
+#define VIRTIO_ST_DRIVER_OK 0x04
+#define VIRTIO_ST_FEAT_OK   0x08
+
+#define VIRTQ_DESC_F_WRITE 0x02
+
+struct virtq_desc {
+    uint64_t addr;
+    uint32_t len;
+    uint16_t flags;
+    uint16_t next;
+} __attribute__((packed));
+
+struct virtq_avail {
+    uint16_t flags;
+    uint16_t idx;
+    uint16_t ring[VIRTQ_N];
+} __attribute__((packed));
+
+struct virtq_used {
+    uint16_t flags;
+    uint16_t idx;
+    struct { uint32_t id; uint32_t len; } ring[VIRTQ_N];
+} __attribute__((packed));
+
+typedef struct {
+    uint16_t iobase;
+    struct virtq_desc*  desc;
+    struct virtq_avail* avail;
+    struct virtq_used*  used;
+    uint8_t* rxbuf[VIRTQ_N];
+    uint8_t* txbuf;
+    uint16_t rx_seen;
+    uint16_t tx_seen;
+    int      tx_inflight;
+} virtio_net_dev_t;
+
+static virtio_net_dev_t vt_dev;
+
+static void* virtq_alloc_pages(uint32_t bytes) {
+    uint8_t* blk = (uint8_t*)kmalloc(bytes + 0x1000);
+    if (!blk) return NULL;
+    uintptr_t a = ((uintptr_t)blk + 0xFFF) & ~(uintptr_t)0xFFF;
+    memset((void*)a, 0, bytes);
+    return (void*)a;
+}
+
+static int virtio_net_probe(uint8_t bus, uint8_t slot, uint8_t func, uint16_t vendor, uint16_t device) {
+    if (vendor != 0x1AF4 || device != 0x1000) return 0;
+
+    uint32_t bar0 = pci_config_read(bus, slot, func, 0x10);
+    if (!(bar0 & 0x1)) return 0;
+
+    virtio_net_dev_t* dev = &vt_dev;
+    memset(dev, 0, sizeof(*dev));
+    dev->iobase = (uint16_t)(bar0 & 0xFFFFFFFC);
+    net_pci_enable(bus, slot, func, 0x1);
+
+    outb(dev->iobase + VIRTIO_DEV_STATUS, 0);
+    (void)inb(dev->iobase + VIRTIO_ISR_STATUS);
+    outb(dev->iobase + VIRTIO_DEV_STATUS, VIRTIO_ST_ACK);
+    outb(dev->iobase + VIRTIO_DEV_STATUS, VIRTIO_ST_ACK | VIRTIO_ST_DRIVER);
+
+    (void)inl(dev->iobase + VIRTIO_DEV_FEATURES);
+    outl(dev->iobase + VIRTIO_GUEST_FEATURES, 0);
+
+    outw(dev->iobase + VIRTIO_QUEUE_SEL, 0);
+    uint16_t rx_qsize = inw(dev->iobase + VIRTIO_QUEUE_SIZE);
+    outw(dev->iobase + VIRTIO_QUEUE_SEL, 1);
+    uint16_t tx_qsize = inw(dev->iobase + VIRTIO_QUEUE_SIZE);
+    if (rx_qsize < VIRTQ_N || tx_qsize < VIRTQ_N) return 0;
+
+    outb(dev->iobase + VIRTIO_DEV_STATUS, VIRTIO_ST_ACK | VIRTIO_ST_DRIVER | VIRTIO_ST_FEAT_OK);
+
+    uint32_t desc_sz  = (uint32_t)sizeof(struct virtq_desc) * VIRTQ_N;
+    uint32_t avail_sz = (uint32_t)sizeof(struct virtq_avail);
+    uint32_t used_sz  = (uint32_t)sizeof(struct virtq_used);
+    uint32_t queue_sz = desc_sz + avail_sz + used_sz;
+
+    uint8_t* rx_queue = (uint8_t*)virtq_alloc_pages(queue_sz);
+    uint8_t* tx_queue = (uint8_t*)virtq_alloc_pages(queue_sz);
+    if (!rx_queue || !tx_queue) return 0;
+
+    for (int i = 0; i < VIRTQ_N; i++) {
+        dev->rxbuf[i] = (uint8_t*)kmalloc(VIRTQ_BUF);
+        if (!dev->rxbuf[i]) return 0;
+    }
+    dev->txbuf = (uint8_t*)kmalloc(VIRTQ_BUF);
+    if (!dev->txbuf) return 0;
+
+    struct virtq_desc*  rx_desc  = (struct virtq_desc*)rx_queue;
+    struct virtq_avail* rx_avail = (struct virtq_avail*)(rx_queue + desc_sz);
+    dev->used                    = (struct virtq_used*)(rx_queue + desc_sz + avail_sz);
+
+    struct virtq_desc*  tx_desc  = (struct virtq_desc*)tx_queue;
+    struct virtq_avail* tx_avail = (struct virtq_avail*)(tx_queue + desc_sz);
+    struct virtq_used*  tx_used  = (struct virtq_used*)(tx_queue + desc_sz + avail_sz);
+
+    for (int i = 0; i < VIRTQ_N; i++) {
+        rx_desc[i].addr  = virt_to_phys(dev->rxbuf[i]);
+        rx_desc[i].len   = VIRTQ_BUF;
+        rx_desc[i].flags = VIRTQ_DESC_F_WRITE;
+        rx_desc[i].next  = 0;
+        rx_avail->ring[i] = (uint16_t)i;
+    }
+    rx_avail->idx = VIRTQ_N;
+
+    tx_desc[0].addr  = virt_to_phys(dev->txbuf);
+    tx_desc[0].len   = 0;
+    tx_desc[0].flags = 0;
+    tx_desc[0].next  = 0;
+
+    outw(dev->iobase + VIRTIO_QUEUE_SEL, 0);
+    outl(dev->iobase + VIRTIO_QUEUE_PFN, (uint32_t)(virt_to_phys(rx_queue) >> 12));
+    outw(dev->iobase + VIRTIO_QUEUE_SEL, 1);
+    outl(dev->iobase + VIRTIO_QUEUE_PFN, (uint32_t)(virt_to_phys(tx_queue) >> 12));
+
+    dev->desc  = rx_desc;
+    dev->avail = rx_avail;
+    dev->tx_seen = 0;
+    dev->rx_seen = 0;
+    dev->tx_inflight = 0;
+    (void)tx_used;
+    (void)tx_desc;
+    (void)tx_avail;
+
+    outb(dev->iobase + VIRTIO_DEV_STATUS,
+         VIRTIO_ST_ACK | VIRTIO_ST_DRIVER | VIRTIO_ST_FEAT_OK | VIRTIO_ST_DRIVER_OK);
+
+    uint8_t mac[6];
+    for (int i = 0; i < 6; i++) mac[i] = inb(dev->iobase + VIRTIO_CONFIG_OFF + i);
+    netdev_set_mac(mac);
+
+    outw(dev->iobase + VIRTIO_QUEUE_NOTIFY, 0);
+    netdev_report_link(1);
+    netdev_set_name("virtio-net");
+    return 1;
+}
+
+static void virtio_net_send(const uint8_t* data, uint32_t len) {
+    virtio_net_dev_t* dev = &vt_dev;
+    if (!len || !dev->desc) return;
+    if (len > VIRTQ_BUF) len = VIRTQ_BUF;
+    memcpy(dev->txbuf, data, len);
+    if (len < 60) { memset(dev->txbuf + len, 0, 60 - len); len = 60; }
+    dev->desc[0].len = len;
+    dev->avail->ring[dev->avail->idx % VIRTQ_N] = 0;
+    asm volatile("" ::: "memory");
+    dev->avail->idx++;
+    outw(dev->iobase + VIRTIO_QUEUE_NOTIFY, 1);
+}
+
+static void virtio_net_poll(void) {
+    virtio_net_dev_t* dev = &vt_dev;
+    if (!dev->desc) return;
+    (void)inb(dev->iobase + VIRTIO_ISR_STATUS);
+
+    while (dev->used->idx != dev->rx_seen) {
+        uint32_t id  = dev->used->ring[dev->rx_seen % VIRTQ_N].id;
+        uint32_t len = dev->used->ring[dev->rx_seen % VIRTQ_N].len;
+        dev->rx_seen++;
+        if (id < VIRTQ_N && len >= 14 && len <= 1518)
+            netdev_rx_submit(dev->rxbuf[id], len);
+        dev->avail->ring[dev->avail->idx % VIRTQ_N] = (uint16_t)id;
+        asm volatile("" ::: "memory");
+        dev->avail->idx++;
+    }
+    outw(dev->iobase + VIRTIO_QUEUE_NOTIFY, 0);
+}
+
+static const net_dev_t virtio_net_driver = {
+    "virtio-net",
+    0x1AF4, 0x1000,
+    virtio_net_send,
+    virtio_net_poll,
+    virtio_net_probe
+};
+
+const net_dev_t* virtio_net_driver_get(void) { return &virtio_net_driver; }
diff --git a/src/net/firewall.c b/src/net/firewall.c
index 13e8323..790477d 100644
--- a/src/net/firewall.c
+++ b/src/net/firewall.c
@@ -63,21 +63,18 @@ static firewall_connection_t firewall_connections[FIREWALL_CONNECTION_LIMIT];
 static firewall_rate_source_t firewall_rate_sources[FIREWALL_RATE_SOURCE_LIMIT];
 static firewall_rule_rate_t firewall_rule_rates[FIREWALL_RULE_RATE_LIMIT];
 static firewall_service_t firewall_services[FIREWALL_SERVICE_LIMIT];
-static uint8_t firewall_default[3] = {   /* IN, OUT, FORWARD */
