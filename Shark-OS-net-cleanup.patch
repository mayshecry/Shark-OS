diff --git a/tests/tcp_server_recovery_test.c b/tests/tcp_server_recovery_test.c
new file mode 100644
index 0000000..52b64b5
--- /dev/null
+++ b/tests/tcp_server_recovery_test.c
@@ -0,0 +1,203 @@
+
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#define CONNECTIONS 8
+#define SYN_TIMEOUT   4000u
+#define IDLE_TIMEOUT  30000u
+#define KEEPALIVE     3000u
+#define KA_TRIES      3
+
+typedef struct {
+    int state;
+    int accepted, peer_closed, local_closed, busy;
+    uint16_t lport, pport;
+    uint32_t last_rx, last_tx;
+    int retries, keepalive;
+} conn_t;
+
+static conn_t conns[CONNECTIONS];
+static uint32_t now;
+static int sent_synack, sent_fin, sent_rst, sent_keepalive;
+
+static void emit(int idx, int flag) {
+    if (flag == 0x12) sent_synack++;
+    else if (flag == 0x11) sent_fin++;
+    else if (flag == 0x14) sent_rst++;
+    else if (flag == 0x10) sent_keepalive++;
+    conns[idx].last_tx = now;
+}
+
+
+static int on_syn(uint16_t sport, uint16_t dport) {
+    int free_slot = -1, stale = -1;
+    for (int i = 0; i < CONNECTIONS; i++) {
+        conn_t* q = &conns[i];
+        if (q->state && q->lport == dport && q->pport == sport) return i;
+        if (!q->state && free_slot < 0) free_slot = i;
+        if (q->state == 1 && stale < 0 && now - q->last_rx >= SYN_TIMEOUT) stale = i;
+    }
+    if (free_slot < 0 && stale >= 0) {
+        memset(&conns[stale], 0, sizeof(conn_t));
+        free_slot = stale;
+    }
+    if (free_slot < 0) return -1;
+    conn_t* c = &conns[free_slot];
+    memset(c, 0, sizeof(*c));
+    c->lport = dport;
+    c->pport = sport;
+    c->state = 1;
+    c->last_rx = c->last_tx = now;
+    emit(free_slot, 0x12);
+    return free_slot;
+}
+
+static int accept_conn(uint16_t port) {
+    for (int i = 0; i < CONNECTIONS; i++)
+        if (conns[i].state == 2 && !conns[i].accepted && conns[i].lport == port) {
+            conns[i].accepted = 1;
+            return i;
+        }
+    return -1;
+}
+
+static void establish(int i) {
+    conns[i].state = 2;
+    conns[i].last_rx = now;
+}
+
+
+static void close_conn(int i) {
+    if (conns[i].state == 2 && !conns[i].local_closed) emit(i, 0x11);
+    memset(&conns[i], 0, sizeof(conn_t));
+}
+
+
+static void reap(void) {
+    for (int i = 0; i < CONNECTIONS; i++) {
+        conn_t* c = &conns[i];
+        if (!c->state || c->busy) continue;
+        if (c->state == 1) {
+            if (now - c->last_rx >= SYN_TIMEOUT) memset(c, 0, sizeof(conn_t));
+            continue;
+        }
+        if (c->peer_closed) {
+            if (now - c->last_rx >= 1000) memset(c, 0, sizeof(conn_t));
+            continue;
+        }
+        if (now - c->last_rx >= IDLE_TIMEOUT) {
+            emit(i, 0x14);
+            memset(c, 0, sizeof(conn_t));
+            continue;
+        }
+        if (now - c->last_tx >= KEEPALIVE) {
+            if (c->retries >= KA_TRIES) {
+                emit(i, 0x14);
+                memset(c, 0, sizeof(conn_t));
+                continue;
+            }
+            c->retries++;
+            c->keepalive++;
+            emit(i, 0x10);
+        }
+    }
+}
+
+
+static void peer_talks(int i) {
+    conns[i].last_rx = now;
+    conns[i].retries = 0;
+    conns[i].keepalive = 0;
+    emit(i, 0x10);
+}
+
+static int free_slots(void) {
+    int n = 0;
+    for (int i = 0; i < CONNECTIONS; i++) if (!conns[i].state) n++;
+    return n;
+}
+
+int main(void) {
+    int failures = 0;
+
+    printf("1. abandoned half-open handshakes drain themselves\n");
+    memset(conns, 0, sizeof(conns));
+    now = 0;
+    for (int i = 0; i < CONNECTIONS; i++) on_syn((uint16_t)(1000 + i), 80);
+    printf("   table after %d SYNs: free=%d\n", CONNECTIONS, free_slots());
+    now = SYN_TIMEOUT + 10;
+    reap();
+    printf("   after the SYN timeout: free=%d\n", free_slots());
+    if (free_slots() != CONNECTIONS) { printf("   FAIL\n"); failures++; }
+    else printf("   PASS\n");
+
+    printf("2. a full table still answers a new SYN by evicting a stale slot\n");
+    memset(conns, 0, sizeof(conns));
+    now = 0;
+    for (int i = 0; i < CONNECTIONS; i++) on_syn((uint16_t)(2000 + i), 80);
+    now = SYN_TIMEOUT + 5;
+    int slot = on_syn(2999, 80);
+    printf("   new SYN while full -> slot %d\n", slot);
+    if (slot < 0) { printf("   FAIL\n"); failures++; } else printf("   PASS\n");
+
+    printf("3. a client that connects and never sends a request is reclaimed\n");
+    memset(conns, 0, sizeof(conns));
+    now = 0;
+    int c = on_syn(3000, 80);
+    establish(c);
+    int h = accept_conn(80);
+    for (now = 0; now <= IDLE_TIMEOUT + 5; now += 250) reap();
+    printf("   connection was accepted as %d, slot now free: %d\n", h, !conns[h].state);
+    printf("   keepalives sent: %d, resets: %d\n", sent_keepalive, sent_rst);
+    if (conns[h].state) { printf("   FAIL\n"); failures++; } else printf("   PASS\n");
+
+    printf("4. a live connection survives keepalives and stays usable\n");
+    memset(conns, 0, sizeof(conns));
+    sent_keepalive = sent_rst = 0;
+    now = 0;
+    c = on_syn(3001, 80);
+    establish(c);
+    h = accept_conn(80);
+    for (now = 0; now <= 20000; now += 500) {
+        reap();
+        peer_talks(h);
+    }
+    printf("   live slot still open: %d, keepalives: %d, resets: %d\n",
+           conns[h].state == 2, sent_keepalive, sent_rst);
+    if (conns[h].state != 2 || sent_rst) { printf("   FAIL\n"); failures++; }
+    else printf("   PASS\n");
+
+    printf("5. closing after a response frees the slot immediately (no TIME_WAIT leak)\n");
+    memset(conns, 0, sizeof(conns));
+    now = 0;
+    c = on_syn(3002, 80);
+    establish(c);
+    h = accept_conn(80);
+    close_conn(h);
+    printf("   slot free after close: %d, FIN sent: %d of 2 handshakes\n",
+           free_slots() == CONNECTIONS, sent_fin);
+    if (free_slots() != CONNECTIONS) { printf("   FAIL\n"); failures++; }
+    else printf("   PASS\n");
+
+    printf("6. repeated request bursts never exhaust the table\n");
+    memset(conns, 0, sizeof(conns));
+    now = 0;
+    int refused = 0;
+    for (int req = 0; req < 500; req++) {
+        now += 7;
+        int s = on_syn((uint16_t)(4000 + (req % 3000)), 80);
+        if (s < 0) { refused++; reap(); continue; }
+        establish(s);
+        int hh = accept_conn(80);
+        if (hh >= 0) close_conn(hh);
+        reap();
+    }
+    printf("   500 requests, refused: %d, free slots at end: %d\n", refused, free_slots());
+    if (refused || free_slots() != CONNECTIONS) { printf("   FAIL\n"); failures++; }
+    else printf("   PASS\n");
+
+    printf("\n%s\n", failures ? "SOME CHECKS FAILED" : "ALL CHECKS PASSED");
+    return failures ? 1 : 0;
+}
diff --git a/tests/tcp_server_stall_repro.c b/tests/tcp_server_stall_repro.c
new file mode 100644
index 0000000..bef29ce
--- /dev/null
+++ b/tests/tcp_server_stall_repro.c
@@ -0,0 +1,156 @@
+
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#define TCP_SERVER_CONNECTIONS 8
+
+typedef struct {
+    uint8_t state;
+    uint8_t accepted;
+    uint8_t peer_closed;
+    uint8_t local_closed;
+    uint16_t local_port, peer_port;
+    uint32_t send_seq, send_acked, recv_seq;
+} conn_t;
+
+static conn_t connections[TCP_SERVER_CONNECTIONS];
+static int stat_free = 0, stat_handshake_wait = 0, stat_established = 0, stat_wait = 0;
+
+static int is_listening(uint16_t port) { return port == 80; }
+
+
+static int accept_conn(uint16_t port) {
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++)
+        if (connections[i].state == 2 && !connections[i].accepted &&
+            connections[i].local_port == port) {
+            connections[i].accepted = 1;
+            return i;
+        }
+    return -1;
+}
+
+
+static int on_syn(uint16_t sport, uint16_t dport) {
+    int free_slot = -1;
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++) {
+        conn_t* q = &connections[i];
+        if (q->state && q->local_port == dport && q->peer_port == sport) return -2;
+        if (!q->state && free_slot < 0) free_slot = i;
+    }
+    if (!is_listening(dport) || free_slot < 0) return -1;
+    conn_t* c = &connections[free_slot];
+    memset(c, 0, sizeof(*c));
+    c->local_port = dport;
+    c->peer_port = sport;
+    c->send_seq = 1000;
+    c->recv_seq = 5000;
+    c->state = 1;
+    return free_slot;
+}
+
+static void on_ack_handshake(int i) {
+    conn_t* c = &connections[i];
+    if (c->state == 1) { c->state = 2; c->send_acked = c->send_seq + 1; }
+}
+
+
+static void httpd_closes(int handle) {
+    conn_t* c = &connections[handle];
+    memset(c, 0, sizeof(*c));
+}
+
+static void census(void) {
+    stat_free = stat_handshake_wait = stat_established = stat_wait = 0;
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++) {
+        conn_t* c = &connections[i];
+        if (!c->state) stat_free++;
+        else if (c->state == 1) stat_handshake_wait++;
+        else if (c->peer_closed) stat_wait++;
+        else stat_established++;
+    }
+}
+
+static int stale_established(void) {
+    int n = 0;
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++)
+        if (connections[i].state == 2 && !connections[i].peer_closed) n++;
+    return n;
+}
+
+int main(void) {
+    memset(connections, 0, sizeof(connections));
+    uint16_t client_port = 40000;
+
+    printf("=== 1. normal request/response cycle (what happens today) ===\n");
+    for (int req = 1; req <= 3; req++) {
+        int slot = on_syn(client_port++, 80);
+        on_ack_handshake(slot);
+        int handle = accept_conn(80);
+        census();
+        printf("  request %d: slot=%d free=%d established=%d timewait=%d accept=%d\n",
+               req, slot, stat_free, stat_established, stat_wait, handle);
+        httpd_closes(handle);
+        census();
+        printf("             after close: free=%d established=%d timewait=%d\n",
+               stat_free, stat_established, stat_wait);
+    }
+
+    printf("\n=== 2. a port that is rebound while connections are still in TIME_WAIT ===\n");
+    printf("    (httpd_rearm() / ssh re-arm after a link flap does exactly this)\n");
+    memset(connections, 0, sizeof(connections));
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++) {
+        connections[i].state = 2;
+        connections[i].peer_closed = 1;
+        connections[i].local_port = 80;
+        connections[i].peer_port = (uint16_t)(41000 + i);
+    }
+    census();
+    printf("    before rearm: free=%d timewait=%d\n", stat_free, stat_wait);
+
+
+    printf("    net_tcp_listen(80) -> %s (listener table still holds 80)\n",
+           is_listening(80) ? "0 already listening" : "re-created");
+    int slot = on_syn(42000, 80);
+    printf("    next SYN: slot=%d  => %s\n", slot,
+           slot < 0 ? "DROPPED, no SYN-ACK: browser shows 'connection timed out'"
+                    : "accepted");
+    census();
+    printf("    free=%d timewait=%d\n", stat_free, stat_wait);
+
+    printf("\n=== 3. a client that never finishes its handshake ===\n");
+    printf("    (port scanner, health probe, or a NAT'd guest during a link flap)\n");
+    memset(connections, 0, sizeof(connections));
+    for (int i = 0; i < TCP_SERVER_CONNECTIONS; i++)
+        if (on_syn((uint16_t)(43000 + i), 80) < 0) { printf("    SYN %d dropped\n", i); break; }
+    int refused = on_syn(44000, 80);
+    printf("    after %d half-open handshakes: next SYN slot=%d (%s), stale established=%d\n",
+           TCP_SERVER_CONNECTIONS, refused, refused < 0 ? "dropped, no RST" : "ok",
+           stale_established());
+    printf("    accept() keeps returning: %d (nothing reaps state==1)\n", accept_conn(80));
+
+    printf("\n=== 4. two servers on the same port (httpd + router console) ===\n");
+    memset(connections, 0, sizeof(connections));
+
+    printf("    both held 80: 'port in use' for whoever rebinds second\n");
+
+    printf("\n=== 5. a request accepted twice ===\n");
+    memset(connections, 0, sizeof(connections));
+    int a = on_syn(45000, 80);
+    on_ack_handshake(a);
+    int h1 = accept_conn(80);
+    int h2 = accept_conn(80);
+    printf("    first accept=%d second accept=%d\n", h1, h2);
+    printf("    (accepted flag guards this case)\n");
+
+    printf("\n=== 6. connection closed by peer without a client FIN reaching us ===\n");
+    memset(connections, 0, sizeof(connections));
+    int b = on_syn(46000, 80);
+    on_ack_handshake(b);
+    int h = accept_conn(80);
+    printf("    slot %d: handshake done, request never arrives, no FIN, no timer\n", h);
+    printf("    slot stays: state=%d peer_closed=%d accepted=%d\n",
+           connections[h].state, connections[h].peer_closed, connections[h].accepted);
+    return 0;
+}
diff --git a/tools/strip_comments.py b/tools/strip_comments.py
new file mode 100644
index 0000000..67a2e44
--- /dev/null
+++ b/tools/strip_comments.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""
+Strip comments from C/H sources without touching string or character literals.
+
+Handles // line comments, /* block comments */ and preserves line structure so
+#line-visible offsets and diffs stay readable.
+
+    python3 tools/strip_comments.py FILE [FILE...]
+    python3 tools/strip_comments.py --check FILE   # exit 1 if comments remain
+
+The scanner is a small state machine: normal, line comment, block comment,
+string, char. Escapes inside literals are honoured, so "http://x" survives.
+"""
+
+import sys
+
+
+def strip(text: str) -> str:
+    out = []
+    i = 0
+    n = len(text)
+    state = "code"
+    while i < n:
+        ch = text[i]
+        nxt = text[i + 1] if i + 1 < n else ""
+
+        if state == "code":
+            if ch == "/" and nxt == "/":
+                state = "line"
+                i += 2
+                continue
+            if ch == "/" and nxt == "*":
+                state = "block"
+                i += 2
+                continue
+            if ch == '"':
+                state = "string"
+            elif ch == "'":
+                state = "char"
+            out.append(ch)
+            i += 1
+            continue
+
+        if state == "line":
+            if ch == "\n":
+                state = "code"
+                # keep the trailing newline, drop trailing spaces introduced
+                while out and out[-1] in " \t":
+                    out.pop()
+                out.append("\n")
+            i += 1
+            continue
+
+        if state == "block":
+            if ch == "*" and nxt == "/":
+                state = "code"
+                i += 2
+                # a block comment that ended a line keeps that newline
+                j = i
+                while j < n and text[j] in " \t":
+                    j += 1
+                if j < n and text[j] == "\n":
+                    i = j
+                continue
+            if ch == "\n":
+                out.append("\n")
+            i += 1
+            continue
+
+        if state in ("string", "char"):
+            out.append(ch)
+            if ch == "\\" and nxt:
+                out.append(nxt)
+                i += 2
+                continue
+            if (state == "string" and ch == '"') or (state == "char" and ch == "'"):
+                state = "code"
+            i += 1
+            continue
+
+    return "".join(out)
+
+
+def tidy(text: str) -> str:
+    lines = []
+    for line in text.split("\n"):
+        stripped = line.rstrip()
+        lines.append(stripped)
+    # collapse runs of three or more blank lines
+    collapsed = []
+    blanks = 0
+    for line in lines:
+        if line == "":
+            blanks += 1
+            if blanks > 2:
+                continue
+        else:
+            blanks = 0
+        collapsed.append(line)
+    while collapsed and collapsed[-1] == "":
+        collapsed.pop()
+    return "\n".join(collapsed) + "\n"
+
+
+def has_comment(text: str) -> bool:
+    return strip(text) != text.replace("\r\n", "\n")
+
+
+def main(argv):
+    check = False
+    files = []
+    for arg in argv[1:]:
+        if arg == "--check":
+            check = True
+        else:
+            files.append(arg)
+
+    bad = []
+    for path in files:
+        with open(path, "r", encoding="utf-8", errors="surrogateescape") as fh:
+            original = fh.read()
+        cleaned = tidy(strip(original))
+        if check:
+            if cleaned != original:
+                bad.append(path)
+            continue
+        if cleaned != original:
+            with open(path, "w", encoding="utf-8", errors="surrogateescape") as fh:
+                fh.write(cleaned)
+            print("stripped " + path, file=sys.stderr)
+
+    if check and bad:
+        print("comments remain in: " + " ".join(bad))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
